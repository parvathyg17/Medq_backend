# Django Configuration
SECRET_KEY=django-insecure-medq-medical-equipment-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL by default; toggle USE_SQLITE=True for instant offline dev)
USE_SQLITE=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=medq
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=120
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
